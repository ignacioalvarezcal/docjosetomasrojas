---
/**
 * Sección Sobre mí – Dr. José Tomás Rojas Vera
 */

import profileImage from "@assets/images/hero-slide/JoSlideMobile2.png"; // reemplaza cuando tengas la foto real
import ContactLayout from "@layouts/ContactLayout.astro";
import { Image } from "astro:assets";
---

<ContactLayout
	title="Sobre mí"
	description="Conoce al Dr. José Tomás Rojas Vera, implantólogo y rehabilitador oral en Providencia."
>
	<section id="about" class="site-container scroll-mt-10 py-10 md:py-16 lg:py-20">
		<div class="grid items-start gap-10 md:grid-cols-[minmax(0,3fr)_minmax(260px,2fr)] lg:gap-16">
			{/* COLUMNA TEXTO */}
			<div>
				<span
					class="border-primary-100 bg-primary-50 text-primary-600 inline-flex items-center rounded-full border px-4 py-1 text-xs font-semibold tracking-[0.16em] uppercase"
				>
					Implantología & Rehabilitación Oral
				</span>

				<h1
					class="font-heading-1 text-base-900 mt-4 text-3xl leading-tight text-balance md:text-4xl lg:text-5xl"
				>
					Dr. José Tomás Rojas Vera
				</h1>

				<p class="text-primary-400 mt-2 text-base font-medium tracking-[0.18em] uppercase">
					Implantólogo y Odontólogo Estético en Providencia
				</p>

				<p class="text-base-700 mt-6 text-base leading-relaxed md:text-lg">
					Mi propósito es devolverle a cada paciente la tranquilidad de sonreír con seguridad.
					Combino{" "}
					<span class="text-primary-600 font-semibold"> tecnología de última generación </span>{" "}
					con una planificación personalizada para lograr resultados naturales, armónicos y duraderos,
					siempre priorizando el bienestar integral y la experiencia en consulta.
				</p>

				<p class="text-base-700 mt-4 text-base leading-relaxed md:text-lg">
					Acompaño a mis pacientes en cada etapa del tratamiento, desde el diagnóstico hasta el
					seguimiento final, con una atención cercana, clara y sin sorpresas. Mi compromiso es
					ofrecer una odontología moderna,{" "}
					<span class="text-primary-600 font-semibold">basada en evidencia</span>{" "}
					y enfocada en minimizar el dolor y la ansiedad asociada a los procedimientos dentales.
				</p>

				{/* LISTA DE VALORES DIFERENCIADORES */}
				<div class="mt-6 grid gap-4 sm:grid-cols-2">
					<div class="flex gap-3">
						<div
							class="border-primary-100 bg-primary-50 text-primary-600 mt-1 h-6 w-6 shrink-0 rounded-full border text-center text-sm leading-6"
						>
							✓
						</div>
						<div>
							<p class="text-base-900 font-semibold">Enfoque integral del caso</p>
							<p class="text-base-600 text-sm">
								Estudio detallado de hueso, encía, estética y función antes de indicar cualquier
								tratamiento.
							</p>
						</div>
					</div>

					<div class="flex gap-3">
						<div
							class="border-primary-100 bg-primary-50 text-primary-600 mt-1 h-6 w-6 shrink-0 rounded-full border text-center text-sm leading-6"
						>
							✓
						</div>
						<div>
							<p class="text-base-900 font-semibold">Tecnología de vanguardia</p>
							<p class="text-base-600 text-sm">
								Uso de radiografías 3D, planificación digital y materiales certificados
								internacionalmente.
							</p>
						</div>
					</div>

					<div class="flex gap-3">
						<div
							class="border-primary-100 bg-primary-50 text-primary-600 mt-1 h-6 w-6 shrink-0 rounded-full border text-center text-sm leading-6"
						>
							✓
						</div>
						<div>
							<p class="text-base-900 font-semibold">Experiencia centrada en el paciente</p>
							<p class="text-base-600 text-sm">
								Comunicación clara, acompañamiento constante y control del dolor en cada
								procedimiento.
							</p>
						</div>
					</div>

					<div class="flex gap-3">
						<div
							class="border-primary-100 bg-primary-50 text-primary-600 mt-1 h-6 w-6 shrink-0 rounded-full border text-center text-sm leading-6"
						>
							✓
						</div>
						<div>
							<p class="text-base-900 font-semibold">Resultados estéticos y funcionales</p>
							<p class="text-base-600 text-sm">
								Sonrisas armónicas que se integran con naturalidad al rostro y mejoran la calidad de
								vida.
							</p>
						</div>
					</div>
				</div>

				{/* DATOS RÁPIDOS Y CTA */}
				<div
					class="border-base-200 mt-8 flex flex-col gap-6 border-t pt-6 md:flex-row md:items-center md:justify-between"
				>
					<div class="grid grid-cols-2 gap-4 sm:flex sm:gap-8">
						<div>
							<p class="text-base-500 text-xs font-medium tracking-[0.14em] uppercase">
								Experiencia
							</p>
							<p class="text-base-900 mt-1 text-2xl font-semibold">+10 años</p>
						</div>
						<div>
							<p class="text-base-500 text-xs font-medium tracking-[0.14em] uppercase">
								Implantes colocados
							</p>
							<p class="text-base-900 mt-1 text-2xl font-semibold">+1.000</p>
						</div>
						<div>
							<p class="text-base-500 text-xs font-medium tracking-[0.14em] uppercase">Enfoque</p>
							<p class="text-primary-600 mt-1 text-sm font-semibold">
								Odontología mínimamente invasiva
							</p>
						</div>
					</div>

					<div class="flex flex-col items-start gap-3 sm:items-end">
						<p class="text-base-600 text-sm">
							¿Quieres saber si eres candidato a implantes o rehabilitación oral?
						</p>
						<a
							href="/contacto"
							class="bg-primary-500 shadow-primary-500/20 hover:bg-primary-600 hover:shadow-primary-500/30 inline-flex items-center justify-center rounded-full px-6 py-2.5 text-sm font-semibold text-white shadow-md transition hover:shadow-lg"
						>
							Agenda tu evaluación
						</a>
					</div>
				</div>
			</div>

			{/* COLUMNA IMAGEN / PERFIL */}
			<div class="order-first self-start md:order-none">
				<div
					class="from-primary-50 via-base-0 to-base-0 relative mx-auto max-w-xs overflow-hidden rounded-3xl bg-gradient-to-b p-[2px] shadow-xl md:max-w-sm"
				>
					<div class="bg-base-0 relative h-full w-full overflow-hidden rounded-3xl">
						<div class="aspect-[3/4] w-full">
							<Image
								src={profileImage}
								alt="Dr. José Tomás Rojas Vera, implantólogo y odontólogo estético en Providencia"
								width={480}
								densities={[1.5, 2]}
								class="h-full w-full object-cover"
								loading="lazy"
							/>
						</div>

						{/* Tarjeta flotante sobre la foto */}
						<div
							class="pointer-events-none absolute right-4 bottom-4 left-4 rounded-2xl bg-white/95 p-3 shadow-lg backdrop-blur"
						>
							<p class="text-primary-500 text-xs font-medium tracking-[0.16em] uppercase">
								Tu sonrisa, en manos expertas
							</p>
							<p class="text-base-700 mt-1 text-sm">
								Evaluaciones detalladas, planificación digital y un equipo dedicado a que tu
								tratamiento sea cómodo y predecible.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</ContactLayout>
