---
/**
 * Sección Sobre mí – Dr. José Tomás Rojas Vera
 */

import profileImage from "@assets/images/hero-slide/JoSlideMobile2.png"; // reemplaza cuando tengas la foto real
import ContactLayout from "@layouts/ContactLayout.astro";
import { Image } from "astro:assets";
---

<ContactLayout
  title="Sobre mí"
  description="Conoce al Dr. José Tomás Rojas Vera, implantólogo y rehabilitador oral en Providencia."
>
  <section
    id="about"
    class="site-container scroll-mt-10 py-10 md:py-16 lg:py-20"
  >
    <div
      class="grid items-start gap-10 md:grid-cols-[minmax(0,3fr)_minmax(260px,2fr)] lg:gap-16"
    >
      {/* COLUMNA TEXTO */}
      <div>
        <span
          class="inline-flex items-center rounded-full border border-primary-100 bg-primary-50 px-4 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-primary-600"
        >
          Implantología & Rehabilitación Oral
        </span>

        <h1 class="mt-4 text-balance font-heading-1 text-3xl leading-tight text-base-900 md:text-4xl lg:text-5xl">
          Dr. José Tomás Rojas Vera
        </h1>

        <p class="mt-2 text-base font-medium uppercase tracking-[0.18em] text-primary-400">
          Implantólogo y Odontólogo Estético en Providencia
        </p>

        <p class="mt-6 text-base leading-relaxed text-base-700 md:text-lg">
          Mi propósito es devolverle a cada paciente la tranquilidad de sonreír
          con seguridad. Combino{" "}
          <span class="font-semibold text-primary-600">
            tecnología de última generación
          </span>{" "}
          con una planificación personalizada para lograr resultados naturales,
          armónicos y duraderos, siempre priorizando el bienestar integral y la
          experiencia en consulta.
        </p>

        <p class="mt-4 text-base leading-relaxed text-base-700 md:text-lg">
          Acompaño a mis pacientes en cada etapa del tratamiento, desde el
          diagnóstico hasta el seguimiento final, con una atención cercana,
          clara y sin sorpresas. Mi compromiso es ofrecer una odontología
          moderna,{" "}
          <span class="font-semibold text-primary-600">basada en evidencia</span>{" "}
          y enfocada en minimizar el dolor y la ansiedad asociada a los
          procedimientos dentales.
        </p>

        {/* LISTA DE VALORES DIFERENCIADORES */}
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <div class="flex gap-3">
            <div
              class="mt-1 h-6 w-6 shrink-0 rounded-full border border-primary-100 bg-primary-50 text-center text-sm leading-6 text-primary-600"
            >
              ✓
            </div>
            <div>
              <p class="font-semibold text-base-900">
                Enfoque integral del caso
              </p>
              <p class="text-sm text-base-600">
                Estudio detallado de hueso, encía, estética y función antes de
                indicar cualquier tratamiento.
              </p>
            </div>
          </div>

          <div class="flex gap-3">
            <div
              class="mt-1 h-6 w-6 shrink-0 rounded-full border border-primary-100 bg-primary-50 text-center text-sm leading-6 text-primary-600"
            >
              ✓
            </div>
            <div>
              <p class="font-semibold text-base-900">
                Tecnología de vanguardia
              </p>
              <p class="text-sm text-base-600">
                Uso de radiografías 3D, planificación digital y materiales
                certificados internacionalmente.
              </p>
            </div>
          </div>

          <div class="flex gap-3">
            <div
              class="mt-1 h-6 w-6 shrink-0 rounded-full border border-primary-100 bg-primary-50 text-center text-sm leading-6 text-primary-600"
            >
              ✓
            </div>
            <div>
              <p class="font-semibold text-base-900">
                Experiencia centrada en el paciente
              </p>
              <p class="text-sm text-base-600">
                Comunicación clara, acompañamiento constante y control del dolor
                en cada procedimiento.
              </p>
            </div>
          </div>

          <div class="flex gap-3">
            <div
              class="mt-1 h-6 w-6 shrink-0 rounded-full border border-primary-100 bg-primary-50 text-center text-sm leading-6 text-primary-600"
            >
              ✓
            </div>
            <div>
              <p class="font-semibold text-base-900">
                Resultados estéticos y funcionales
              </p>
              <p class="text-sm text-base-600">
                Sonrisas armónicas que se integran con naturalidad al rostro y
                mejoran la calidad de vida.
              </p>
            </div>
          </div>
        </div>

        {/* DATOS RÁPIDOS Y CTA */}
        <div
          class="mt-8 flex flex-col gap-6 border-t border-base-200 pt-6 md:flex-row md:items-center md:justify-between"
        >
          <div class="grid grid-cols-2 gap-4 sm:flex sm:gap-8">
            <div>
              <p class="text-xs font-medium uppercase tracking-[0.14em] text-base-500">
                Experiencia
              </p>
              <p class="mt-1 text-2xl font-semibold text-base-900">+10 años</p>
            </div>
            <div>
              <p class="text-xs font-medium uppercase tracking-[0.14em] text-base-500">
                Implantes colocados
              </p>
              <p class="mt-1 text-2xl font-semibold text-base-900">+1.000</p>
            </div>
            <div>
              <p class="text-xs font-medium uppercase tracking-[0.14em] text-base-500">
                Enfoque
              </p>
              <p class="mt-1 text-sm font-semibold text-primary-600">
                Odontología mínimamente invasiva
              </p>
            </div>
          </div>

          <div class="flex flex-col items-start gap-3 sm:items-end">
            <p class="text-sm text-base-600">
              ¿Quieres saber si eres candidato a implantes o rehabilitación
              oral?
            </p>
            <a
              href="/contacto"
              class="inline-flex items-center justify-center rounded-full bg-primary-500 px-6 py-2.5 text-sm font-semibold text-white shadow-md shadow-primary-500/20 transition hover:bg-primary-600 hover:shadow-lg hover:shadow-primary-500/30"
            >
              Agenda tu evaluación
            </a>
          </div>
        </div>
      </div>

      {/* COLUMNA IMAGEN / PERFIL */}
      <div class="order-first self-start md:order-none">
        <div
          class="relative mx-auto max-w-xs overflow-hidden rounded-3xl bg-gradient-to-b from-primary-50 via-base-0 to-base-0 p-[2px] shadow-xl md:max-w-sm"
        >
          <div class="relative h-full w-full overflow-hidden rounded-3xl bg-base-0">
            <div class="aspect-[3/4] w-full">
              <Image
                src={profileImage}
                alt="Dr. José Tomás Rojas Vera, implantólogo y odontólogo estético en Providencia"
                width={480}
                densities={[1.5, 2]}
                class="h-full w-full object-cover"
                loading="lazy"
              />
            </div>

            {/* Tarjeta flotante sobre la foto */}
            <div
              class="pointer-events-none absolute bottom-4 left-4 right-4 rounded-2xl bg-white/95 p-3 shadow-lg backdrop-blur"
            >
              <p class="text-xs font-medium uppercase tracking-[0.16em] text-primary-500">
                Tu sonrisa, en manos expertas
              </p>
              <p class="mt-1 text-sm text-base-700">
                Evaluaciones detalladas, planificación digital y un equipo
                dedicado a que tu tratamiento sea cómodo y predecible.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</ContactLayout>