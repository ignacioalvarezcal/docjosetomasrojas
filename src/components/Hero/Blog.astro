<style>
	/* ===== SECCIÓN ===== */
	.blog-section {
		padding: 6rem 8vw;
		background: #ffffff;
	}

	.blog-container {
		max-width: 1200px;
		margin: 0 auto;
	}

	.blog-section-header {
		margin-bottom: 0;
	}

	.blog-title {
		font-family: "Playfair Display", serif;
		font-size: clamp(1.7rem, 5vw, 2.2rem);
		color: var(--heading, #2f3e46);
		margin-bottom: 1.5rem;
	}

	/* ===== GRID DESKTOP ===== */
	.blog-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
	}

	/* ===== CAROUSEL MÓVIL (oculto en desktop) ===== */
	.blog-carousel-wrapper { display: none; }

	/* ===== CARD ===== */
	.blog-card {
		background: #fff;
		border: 1px solid #e6e6e6;
		border-radius: 12px;
		overflow: hidden;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		cursor: pointer;
		text-decoration: none;
		display: block;
		color: inherit;
	}

	.blog-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 14px 40px rgba(0, 0, 0, 0.1);
	}

	/* Imagen placeholder (sin imagen real aún) */
	.blog-card-thumb {
		width: 100%;
		aspect-ratio: 16 / 9;
		background: #dde3e4;
		display: block;
		overflow: hidden;
		position: relative;
	}

	.blog-card-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.4s ease;
	}

	.blog-card:hover .blog-card-thumb img {
		transform: scale(1.03);
	}

	/* Icono decorativo sobre placeholder vacío */
	.blog-card-thumb-icon {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0.25;
	}

	.blog-card-thumb-icon svg {
		width: 40px;
		height: 40px;
		color: var(--primary, #4f7a7c);
	}

	.blog-card-body {
		padding: 1.1rem 1.25rem 1.3rem;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--heading, #2f3e46);
		line-height: 1.45;
	}

	/* ===== BOTÓN ===== */
	.blog-cta-wrap {
		margin-top: 2.5rem;
	}

	.blog-btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 14px 38px;
		background: var(--primary, #4f7a7c);
		color: #ffffff;
		text-decoration: none;
		font-size: 0.9rem;
		letter-spacing: 0.06em;
		border-radius: 8px;
		transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
	}

	.blog-btn:hover {
		background: #3f6668;
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(79, 122, 124, 0.28);
	}

	/* ===== TABLET ===== */
	@media (max-width: 900px) {
		.blog-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	/* ===== MÓVIL: carousel ===== */
	@media (max-width: 640px) {
		.blog-section {
			padding: 3.5rem 0 3.5rem;
		}

		.blog-section-header {
			padding: 0 5vw;
		}

		/* Ocultar grid, mostrar carousel */
		.blog-grid { display: none; }
		.blog-carousel-wrapper { display: block; }

		/* Track */
		.blog-carousel {
			display: flex;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
			gap: 1rem;
			padding: 0.5rem 5vw 1.2rem;
			scroll-padding-left: 5vw;
		}

		.blog-carousel::-webkit-scrollbar { display: none; }

		/* Slide */
		.blog-carousel .blog-card {
			flex: 0 0 82vw;
			max-width: 320px;
			scroll-snap-align: center;
			transform: scale(0.96);
			transition:
				transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
				box-shadow 0.4s ease;
			box-shadow: 0 4px 20px rgba(0, 0, 0, 0.07);
		}

		.blog-carousel .blog-card.is-active {
			transform: scale(1);
			box-shadow: 0 12px 40px rgba(0, 0, 0, 0.13);
		}

		/* Dots */
		.blog-dots {
			display: flex;
			justify-content: center;
			gap: 6px;
			margin-top: 1rem;
		}

		.blog-dot {
			width: 6px;
			height: 6px;
			border-radius: 50%;
			background: #d1d5db;
			transition: background 0.3s ease, width 0.3s ease;
			cursor: pointer;
			border: none;
			padding: 0;
		}

		.blog-dot.is-active {
			background: var(--primary, #4f7a7c);
			width: 18px;
			border-radius: 3px;
		}

		.blog-cta-wrap {
			padding: 0 5vw;
			margin-top: 2rem;
		}

		.blog-btn {
			width: 100%;
			justify-content: center;
		}
	}
</style>

<!-- SVG icono reutilizable para placeholders -->
<svg style="display:none">
	<symbol id="icon-article" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
		<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
		<polyline points="14 2 14 8 20 8"/>
		<line x1="16" y1="13" x2="8" y2="13"/>
		<line x1="16" y1="17" x2="8" y2="17"/>
		<polyline points="10 9 9 9 8 9"/>
	</symbol>
</svg>

<section id="blog" class="blog-section">
	<div class="blog-container">

		<div class="blog-section-header">
			<h2 class="blog-title">Educación dental</h2>
		</div>

		<!-- DESKTOP: grid 3 columnas -->
		<div class="blog-grid">
			<a href="#" class="blog-card">
				<div class="blog-card-thumb">
					<div class="blog-card-thumb-icon">
						<svg><use href="#icon-article"/></svg>
					</div>
				</div>
				<div class="blog-card-body">¿Qué es un implante dental?</div>
			</a>
			<a href="#" class="blog-card">
				<div class="blog-card-thumb">
					<div class="blog-card-thumb-icon">
						<svg><use href="#icon-article"/></svg>
					</div>
				</div>
				<div class="blog-card-body">¿Qué es una prótesis híbrida?</div>
			</a>
			<a href="#" class="blog-card">
				<div class="blog-card-thumb">
					<div class="blog-card-thumb-icon">
						<svg><use href="#icon-article"/></svg>
					</div>
				</div>
				<div class="blog-card-body">Cuidados post cirugía</div>
			</a>
		</div>

		<!-- MÓVIL: carousel con snap -->
		<div class="blog-carousel-wrapper">
			<div class="blog-carousel" id="blogCarousel" role="list">
				{[
					"¿Qué es un implante dental?",
					"¿Qué es una prótesis híbrida?",
					"Cuidados post cirugía",
				].map((titulo, i) => (
					<a
						href="#"
						class={`blog-card${i === 0 ? " is-active" : ""}`}
						data-index={i}
						role="listitem"
					>
						<div class="blog-card-thumb">
							<div class="blog-card-thumb-icon">
								<svg><use href="#icon-article"/></svg>
							</div>
						</div>
						<div class="blog-card-body">{titulo}</div>
					</a>
				))}
			</div>

			<div class="blog-dots" id="blogDots" role="tablist" aria-label="Artículos de educación dental">
				{[0, 1, 2].map((i) => (
					<button
						class={`blog-dot${i === 0 ? " is-active" : ""}`}
						data-index={i}
						role="tab"
						aria-label={`Artículo ${i + 1}`}
						aria-selected={i === 0 ? "true" : "false"}
					/>
				))}
			</div>
		</div>

		<div class="blog-cta-wrap">
			<a href="#" class="blog-btn">Explorar el blog</a>
		</div>
	</div>
</section>

<script>
	(function () {
		const carousel = document.getElementById("blogCarousel");
		const dotsContainer = document.getElementById("blogDots");
		if (!carousel || !dotsContainer) return;

		const cards = Array.from(carousel.querySelectorAll(".blog-card"));
		const dots  = Array.from(dotsContainer.querySelectorAll(".blog-dot"));

		function setActive(index: number) {
			cards.forEach((c, i) => c.classList.toggle("is-active", i === index));
			dots.forEach((d, i) => {
				d.classList.toggle("is-active", i === index);
				d.setAttribute("aria-selected", i === index ? "true" : "false");
			});
		}

		dots.forEach((dot, i) => {
			dot.addEventListener("click", () => {
				cards[i].scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
			});
		});

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting && entry.intersectionRatio >= 0.55) {
						const idx = cards.indexOf(entry.target as HTMLElement);
						if (idx !== -1) setActive(idx);
					}
				});
			},
			{ root: carousel, threshold: 0.55 }
		);

		cards.forEach((card) => observer.observe(card));
	})();
</script>
