---
import heroImageOne from "@images/hero-slide/sobre_mi.png";
---

<style>
	:root {
		--primary: #4f7a7c;
		--heading: #2f3e46;
		--text: #4a4a4a;
		--bg-light: #f6f7f7;
		--accent-soft: #9fb6b8;
	}

	/* ===== SECCIÓN ===== */
	.section {
		background: var(--primary);
		overflow: hidden;
		/* Altura mínima en desktop pero crece con el contenido */
		min-height: 480px;
	}

	/* ===== GRID ===== */
	.grid-2 {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0;
		align-items: stretch;
		max-width: 1200px;
		margin: 0 auto;
		min-height: 480px;
	}

	/* ===== COLUMNA TEXTO ===== */
	.text-col {
		padding: 2.5rem clamp(1.5rem, 5vw, 4rem) 2.5rem clamp(1.5rem, 6vw, 5rem);
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	h2.section-title {
		font-family: "Playfair Display", serif;
		font-size: clamp(1.7rem, 3.5vw, 2.1rem);
		color: var(--bg-light);
		margin-bottom: 1rem;
	}

	p {
		color: var(--bg-light);
	}

	/* ===== COLUMNA FOTO ===== */
	.foto-col {
		overflow: hidden;
		display: flex;
		align-items: flex-start;
		justify-content: center;
	}

	.foto-col img {
		height: 100%;
		width: auto;
		display: block;
		/* En desktop muestra la imagen completa desde arriba */
		object-fit: cover;
		object-position: center top;
	}

	/* ===== ENLACE "VER MÁS" ===== */
	.about-link {
		display: inline-block;
		color: var(--bg-light);
		text-decoration: none;
		font-weight: 500;
		transition: opacity 0.25s ease;
	}

	.about-link:hover,
	.about-link:focus-visible {
		opacity: 0.75;
		outline: none;
	}

	/* ===== RESPONSIVE: tablet ===== */
	@media (max-width: 900px) {
		.section {
			min-height: unset;
			height: auto;
		}

		.grid-2 {
			grid-template-columns: 1fr;
			min-height: unset;
			height: auto;
		}

		/* Foto arriba en móvil, tamaño proporcional */
		.foto-col {
			height: clamp(280px, 55vw, 420px);
			order: -1;
			align-items: center;
		}

		.foto-col img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: center 42%; /* muestra la cara y torso del doctor */
		}

		/* Texto con padding generoso para no pegarse a los bordes */
		.text-col {
			padding: 2.5rem clamp(1.25rem, 7vw, 3rem);
		}
	}

	/* ===== RESPONSIVE: móvil pequeño ===== */
	@media (max-width: 480px) {
		.foto-col {
			height: clamp(260px, 70vw, 360px);
		}

		.text-col {
			padding: 2rem 1.25rem 2.5rem;
		}

		h2.section-title {
			font-size: 1.65rem;
		}
	}
</style>

<section id="about-me" class="section">
	<div class="grid-2">
		<div class="text-col">
			<h2 class="section-title">Sobre mí</h2>
			<p style="line-height:1.6; margin-bottom:0.9rem; font-size:1rem;">
				Soy el Dr. José Tomás Rojas Vera, Cirujano Dentista con enfoque en implantología y
				rehabilitación oral. Mi forma de trabajo se basa en una planificación cuidadosa, la
				precisión clínica y una relación de confianza con cada paciente.
			</p>
			<p style="line-height:1.6; font-size:1rem;">
				Creo en una odontología que acompaña, explica y propone soluciones pensadas para el largo
				plazo, integrando ciencia, experiencia y criterio profesional.
			</p>
			<div style="margin-top:1rem;">
				<a href="/sobre-mi" class="about-link" style="font-size:1rem;">Ver más →</a>
			</div>
		</div>
			<div class="foto-col">
			<img
				src={heroImageOne.src}
				alt="Foto del Dr. José Tomás Rojas Vera"
				style="width:100%; height:100%; object-fit:cover; object-position: center top;"
			/>
		</div>
	</div>
</section>
