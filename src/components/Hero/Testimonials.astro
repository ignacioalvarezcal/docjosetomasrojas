---
import casoUno from "@images/hero-slide/caso_clinico_1.png";
import casoDos from "@images/hero-slide/caso_clinico_2.png";
import casoTres from "@images/hero-slide/caso_clinico_3.png";

const casos = [
	{ src: casoUno.src,  alt: "Implantes en zona estética",   label: "Implantes en zona estética"   },
	{ src: casoDos.src,  alt: "Rehabilitación oral completa", label: "Rehabilitación oral completa" },
	{ src: casoTres.src, alt: "Cirugía oral",                 label: "Cirugía oral"                 },
];
---

<style>
	/* ===== SECCIÓN ===== */
	.casos-section {
		padding: clamp(3.5rem, 8vw, 100px) clamp(1.25rem, 8vw, 6rem);
		background: #ffffff;
	}

	.casos-container {
		max-width: 1200px;
		margin: 0 auto;
	}

	.casos-section-header {
		margin-bottom: 0;
	}

	.casos-title {
		font-family: "Playfair Display", serif;
		font-size: clamp(1.7rem, 5vw, 2.2rem);
		color: var(--heading, #2f3e46);
		margin-bottom: 1.5rem;
	}

	/* ===== GRID DESKTOP ===== */
	.casos-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
	}

	/* ===== CAROUSEL MÓVIL (oculto en desktop) ===== */
	.casos-carousel-wrapper { display: none; }

	/* ===== CARD ===== */
	.caso-card {
		background: #fff;
		border: 1px solid #e6e6e6;
		border-radius: 12px;
		overflow: hidden;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		cursor: pointer;
		text-decoration: none;
		display: block;
		color: inherit;
	}

	.caso-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 14px 40px rgba(0, 0, 0, 0.1);
	}

	.caso-card-img-wrap {
		overflow: hidden;
	}

	.caso-card-img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		display: block;
		transition: transform 0.4s ease;
	}

	.caso-card:hover .caso-card-img {
		transform: scale(1.03);
	}

	.caso-card-body {
		padding: 1.1rem 1.25rem 1.3rem;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--heading, #2f3e46);
		line-height: 1.45;
	}

	/* ===== BOTÓN ===== */
	.casos-cta-wrap {
		margin-top: 2.5rem;
	}

	.casos-btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 14px 38px;
		background: var(--primary, #4f7a7c);
		color: #ffffff;
		text-decoration: none;
		font-size: 0.9rem;
		letter-spacing: 0.06em;
		border-radius: 8px;
		transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
	}

	.casos-btn:hover {
		background: #3f6668;
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(79, 122, 124, 0.28);
	}

	/* ===== TABLET ===== */
	@media (max-width: 900px) {
		.casos-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	/* ===== MÓVIL: carousel ===== */
	@media (max-width: 640px) {
		.casos-section {
			padding: 3.5rem 0 3.5rem;
		}

		.casos-section-header {
			padding: 0 5vw;
		}

		/* Ocultar grid, mostrar carousel */
		.casos-grid { display: none; }
		.casos-carousel-wrapper { display: block; }

		/* Track */
		.casos-carousel {
			display: flex;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
			gap: 1rem;
			padding: 0.5rem 5vw 1.2rem;
			scroll-padding-left: 5vw;
		}

		.casos-carousel::-webkit-scrollbar { display: none; }

		/* Slide */
		.casos-carousel .caso-card {
			flex: 0 0 82vw;
			max-width: 320px;
			scroll-snap-align: center;
			transform: scale(0.96);
			transition:
				transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
				box-shadow 0.4s ease;
			box-shadow: 0 4px 20px rgba(0, 0, 0, 0.07);
		}

		.casos-carousel .caso-card.is-active {
			transform: scale(1);
			box-shadow: 0 12px 40px rgba(0, 0, 0, 0.13);
		}

		/* Dots */
		.casos-dots {
			display: flex;
			justify-content: center;
			gap: 6px;
			margin-top: 1rem;
		}

		.casos-dot {
			width: 6px;
			height: 6px;
			border-radius: 50%;
			background: #d1d5db;
			transition: background 0.3s ease, width 0.3s ease;
			cursor: pointer;
			border: none;
			padding: 0;
		}

		.casos-dot.is-active {
			background: var(--primary, #4f7a7c);
			width: 18px;
			border-radius: 3px;
		}

		.casos-cta-wrap {
			padding: 0 5vw;
			margin-top: 2rem;
		}

		.casos-btn {
			width: 100%;
			justify-content: center;
		}
	}
</style>

<section id="cases" class="casos-section">
	<div class="casos-container">

		<div class="casos-section-header">
			<h2 class="casos-title">Casos clínicos destacados</h2>
		</div>

		<!-- DESKTOP: grid 3 columnas -->
		<div class="casos-grid">
			{casos.map((c) => (
				<a href="/casos-clinicos" class="caso-card">
					<div class="caso-card-img-wrap">
						<img src={c.src} alt={c.alt} class="caso-card-img" loading="lazy" />
					</div>
					<div class="caso-card-body">{c.label}</div>
				</a>
			))}
		</div>

		<!-- MÓVIL: carousel con snap -->
		<div class="casos-carousel-wrapper">
			<div class="casos-carousel" id="casosCarousel" role="list">
				{casos.map((c, i) => (
					<a
						href="/casos-clinicos"
						class={`caso-card${i === 0 ? " is-active" : ""}`}
						data-index={i}
						role="listitem"
					>
						<div class="caso-card-img-wrap">
							<img src={c.src} alt={c.alt} class="caso-card-img" loading="lazy" />
						</div>
						<div class="caso-card-body">{c.label}</div>
					</a>
				))}
			</div>

			<div class="casos-dots" id="casosDots" role="tablist" aria-label="Casos clínicos">
				{casos.map((_, i) => (
					<button
						class={`casos-dot${i === 0 ? " is-active" : ""}`}
						data-index={i}
						role="tab"
						aria-label={`Caso ${i + 1}`}
						aria-selected={i === 0 ? "true" : "false"}
					/>
				))}
			</div>
		</div>

		<div class="casos-cta-wrap">
			<a href="/casos-clinicos" class="casos-btn">Ver todos los casos clínicos</a>
		</div>
	</div>
</section>

<script>
	(function () {
		const carousel = document.getElementById("casosCarousel");
		const dotsContainer = document.getElementById("casosDots");
		if (!carousel || !dotsContainer) return;

		const cards = Array.from(carousel.querySelectorAll(".caso-card"));
		const dots  = Array.from(dotsContainer.querySelectorAll(".casos-dot"));

		function setActive(index: number) {
			cards.forEach((c, i) => c.classList.toggle("is-active", i === index));
			dots.forEach((d, i) => {
				d.classList.toggle("is-active", i === index);
				d.setAttribute("aria-selected", i === index ? "true" : "false");
			});
		}

		dots.forEach((dot, i) => {
			dot.addEventListener("click", () => {
				cards[i].scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
			});
		});

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting && entry.intersectionRatio >= 0.55) {
						const idx = cards.indexOf(entry.target as HTMLElement);
						if (idx !== -1) setActive(idx);
					}
				});
			},
			{ root: carousel, threshold: 0.55 }
		);

		cards.forEach((card) => observer.observe(card));
	})();
</script>
