---
import instaProfile from "@images/hero-slide/insta-profile.jpg";
import video1 from "@videos/reels1.mp4";
import video2 from "@videos/reels2.mp4";
import video3 from "@videos/reels3.mp4";
import video4 from "@videos/reels4.mp4";
---

<style>
    :root {
      --primary: #4F7A7C;
      --heading: #2F3E46;
      --text: #4A4A4A;
      --bg-light: #F6F7F7;
      --accent-soft: #9FB6B8;
    }
    
    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    body {
      font-family: 'Montserrat', sans-serif;
      color: var(--text);
      background: var(--bg-light);
    }

    /* ===== HEADER / BARRA SUPERIOR ===== */
    header{
      position: fixed;
      top: 0;
      width: 100%;
      z-index: 1000;
      background: rgba(255,255,255,0.96);
      border-bottom: 1px solid #e6e6e6;
    }

    .nav-container{
      max-width: 1300px;
      margin: 0 auto;
      padding: 1.1rem 6vw;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo{
      font-family: 'Playfair Display', serif;
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--heading);
      white-space: nowrap;
    }

    nav ul{
      list-style: none;
      display: flex;
      gap: 2.2rem;
    }

    nav a{
      text-decoration: none;
      font-size: 0.85rem;
      letter-spacing: 0.08em;
      color: var(--text);
      font-weight: 400;
    }

    nav a:hover{ color: var(--primary); }

    /* ===== HERO ===== */
    .hero{
      height: 100vh;
      width: 100%;
      background-image: url('Firefly 20260107131824.png');
      background-size: cover;
      background-position: right center;
      display: flex;
      align-items: center;
      padding-left: 8vw;
      padding-top: 90px;
    }

    .hero-content{ max-width: 540px; }

    .hero-content h1{
      font-family: 'Playfair Display', serif;
      font-size: 3.6rem;
      font-weight: 600;
      color: var(--heading);
      margin-bottom: 0.8rem;
    }

    .hero-content h2{
      font-size: 1.3rem;
      font-weight: 400;
      letter-spacing: 0.04em;
      color: var(--primary);
      margin-bottom: 1.4rem;
    }

    .divider{
      width: 52px;
      height: 1px;
      background: var(--primary);
      margin-bottom: 2.2rem;
    }

    .btn{
      display: inline-block;
      padding: 14px 38px;
      background: var(--primary);
      color: #ffffff;
      text-decoration: none;
      font-size: 0.9rem;
      letter-spacing: 0.08em;
      border-radius: 3px;
      transition: background 0.2s ease;
    }

    .btn:hover{ background:#3f6668; }

    section{ padding: 6rem 8vw; }

    .container{ max-width: 1200px; margin: 0 auto; }

    h2.section-title{
      font-family:'Playfair Display',serif;
      font-size:2.2rem;
      color:var(--heading);
      margin-bottom:1.5rem;
    }

    .grid-2{ display:grid; grid-template-columns: repeat(2,1fr); gap:4rem; align-items:center; }
    .grid-3{ display:grid; grid-template-columns: repeat(3,1fr); gap:2rem; }
    .grid-4{ display:grid; grid-template-columns: repeat(4,1fr); gap:2rem; }

    .card{ background:#fff; border:1px solid #e6e6e6; }
    .card-body{ padding:1.5rem; }

    /* ===== REELS PLAYER ===== */
    .reel-item {
      position: relative;
      aspect-ratio: 9 / 16;
      border-radius: 16px;
      overflow: hidden;
      background: #000;
      box-shadow: 0 8px 32px rgba(0,0,0,0.15);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .reel-item:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 48px rgba(0,0,0,0.2);
    }

    .reel-video-container {
      position: relative;
      width: 100%;
      height: 100%;
      cursor: pointer;
    }

    .reel-video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Overlay superior */
    .reel-header {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      padding: 12px 16px;
      background: linear-gradient(180deg, rgba(0,0,0,0.5) 0%, transparent 100%);
      display: flex;
      align-items: center;
      gap: 12px;
      z-index: 10;
    }

    .reel-profile {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: #ddd;
      flex-shrink: 0;
      border: 2px solid #fff;
      cursor: pointer;
    }

    .reel-profile img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
    }

    .reel-username {
      color: #fff;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      flex: 1;
    }

    .reel-follow {
      background: var(--primary);
      color: #fff;
      border: none;
      padding: 6px 14px;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s ease;
    }

    .reel-follow:hover {
      background: #3f6668;
    }

    /* Overlay inferior */
    .reel-footer {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 16px;
      background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.7) 100%);
      z-index: 10;
    }

    .reel-caption {
      color: #fff;
      font-size: 0.9rem;
      line-height: 1.4;
      margin-bottom: 12px;
      cursor: pointer;
    }

    /* Controles derecha */
    .reel-actions {
      position: absolute;
      right: 12px;
      bottom: 80px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      z-index: 10;
    }

    .reel-action-btn {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: rgba(255,255,255,0.1);
      border: none;
      color: #fff;
      font-size: 1.5rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
      backdrop-filter: blur(4px);
    }

    .reel-action-btn:hover {
      background: rgba(255,255,255,0.2);
      transform: scale(1.1);
    }

    .reel-action-btn.liked {
      color: #ff0000;
    }

    .reel-action-count {
      color: #fff;
      font-size: 0.75rem;
      text-align: center;
      margin-top: -10px;
      font-weight: 600;
    }

    /* Reproductor controls */
    .reel-player-controls {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 56px;
      background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.5) 100%);
      display: flex;
      align-items: center;
      padding: 0 12px;
      gap: 8px;
      z-index: 10;
    }

    .play-btn {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: rgba(255,255,255,0.2);
      border: none;
      color: #fff;
      font-size: 0.8rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
    }

    .play-btn:hover {
      background: rgba(255,255,255,0.3);
    }

    .progress-bar {
      flex: 1;
      height: 3px;
      background: rgba(255,255,255,0.2);
      border-radius: 2px;
      cursor: pointer;
      position: relative;
    }

    .progress-bar-fill {
      height: 100%;
      background: var(--primary);
      border-radius: 2px;
      width: 0%;
      transition: width 0.1s linear;
    }

    .volume-btn {
      width: 28px;
      height: 28px;
      background: none;
      border: none;
      color: #fff;
      cursor: pointer;
      font-size: 1rem;
    }

    .time-display {
      color: #fff;
      font-size: 0.7rem;
      min-width: 40px;
      text-align: right;
    }

    /* Modal Instagram */
    .instagram-modal {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.6);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 2000;
      animation: fadeIn 0.3s ease;
    }

    .instagram-modal.active {
      display: flex;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    .instagram-modal-content {
      background: white;
      border-radius: 16px;
      padding: 32px;
      text-align: center;
      max-width: 400px;
      animation: slideUp 0.3s ease;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    }

    @keyframes slideUp {
      from {
        transform: translateY(20px);
        opacity: 0;
      }
      to {
        transform: translateY(0);
        opacity: 1;
      }
    }

    .instagram-logo {
      font-size: 3rem;
      margin-bottom: 16px;
    }

    .instagram-modal-title {
      font-size: 1.5rem;
      color: var(--heading);
      margin-bottom: 8px;
      font-family: 'Playfair Display', serif;
      font-weight: 600;
    }

    .instagram-modal-desc {
      color: var(--text);
      margin-bottom: 24px;
      font-size: 0.95rem;
      line-height: 1.5;
    }

    .instagram-btn-group {
      display: flex;
      gap: 12px;
    }

    .instagram-btn {
      flex: 1;
      padding: 12px 20px;
      border: none;
      border-radius: 8px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .instagram-btn-primary {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }

    .instagram-btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
    }

    .instagram-btn-secondary {
      background: #f0f0f0;
      color: var(--text);
    }

    .instagram-btn-secondary:hover {
      background: #e0e0e0;
    }

    @media (max-width:900px){
      nav ul{ display:none; }
      .hero{
        background-position: center top;
        padding: 120px 7vw;
        align-items: flex-end;
      }
      .hero-content h1{ font-size:2.6rem; }
      .hero-content h2{ font-size:1.15rem; }
      .grid-2,.grid-3{ grid-template-columns:1fr; }
      
      .grid-4{
        display: flex;
        overflow-x: auto;
        gap: 1rem;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 0.5rem;
      }

      .reel-item {
        flex: 0 0 calc(100vw - 12vw);
        scroll-snap-align: start;
      }

      .grid-4::-webkit-scrollbar {
        height: 4px;
      }

      .grid-4::-webkit-scrollbar-track {
        background: #e6e6e6;
      }

      .grid-4::-webkit-scrollbar-thumb {
        background: var(--primary);
        border-radius: 2px;
      }
    }
  </style>

<section style="background:#ffffff;">
  <div class="container">
    <h2 class="section-title">Presencia en redes</h2>
