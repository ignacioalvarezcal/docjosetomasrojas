<!-- Modal Instagram -->
<div class="instagram-modal" id="instagramModal">
  <div class="instagram-modal-content">
    <div class="instagram-logo">📷</div>
    <h3 class="instagram-modal-title">Ver en Instagram</h3>
    <p class="instagram-modal-desc">¿Te gustaría ver este contenido en Instagram?</p>
    <div class="instagram-btn-group">
      <button class="instagram-btn instagram-btn-secondary" onclick="closeInstagramModal()">No, gracias</button>
      <a id="instagramLink" href="" target="_blank" rel="noopener noreferrer" class="instagram-btn instagram-btn-primary" style="text-decoration:none; display:flex; align-items:center; justify-content:center;">Ver en Instagram</a>
    </div>
  </div>
</div>

<script>
  let currentPlayingVideo: HTMLVideoElement | null = null;

  function closeInstagramModal() {
    const modal = document.getElementById('instagramModal');
    if (modal) {
      modal.classList.remove('active');
    }
  }

  function openInstagramModal(instagramUrl: string) {
    const modal = document.getElementById('instagramModal');
    const link = document.getElementById('instagramLink') as HTMLAnchorElement;
    if (modal && link) {
      link.href = instagramUrl;
      modal.classList.add('active');
    }
  }

  // Cerrar modal al hacer click fuera
  const instagramModalElement = document.getElementById('instagramModal');
  if (instagramModalElement) {
    instagramModalElement.addEventListener('click', function(e) {
      if (e.target === this) {
        closeInstagramModal();
      }
    });
  }

  function pauseAllVideos() {
    document.querySelectorAll('.reel-video').forEach((video: Element) => {
      const videoElement = video as HTMLVideoElement;
      if (videoElement !== currentPlayingVideo && !videoElement.paused) {
        videoElement.pause();
        const container = videoElement.closest('.reel-video-container');
        const btn = container?.querySelector('.play-btn');
        if (btn) btn.textContent = '▶️';
      }
    });
  }

  function togglePlay(e: Event) {
    const btn = e.target as HTMLButtonElement;
    const video = btn.closest('.reel-video-container')?.querySelector('video') as HTMLVideoElement;
    
    if (!video) return;

    if (video.paused) {
      pauseAllVideos();
      currentPlayingVideo = video;
      
      // Obtener URL de Instagram
      const container = video.closest('.reel-video-container');
      const instagramLink = container?.querySelector('a') as HTMLAnchorElement;
      const instagramUrl = instagramLink?.href || 'https://instagram.com';
      
      openInstagramModal(instagramUrl);
      
      video.play().catch(err => console.log('Play error:', err));
      btn.textContent = '⏸️';
    } else {
      video.pause();
      currentPlayingVideo = null;
      btn.textContent = '▶️';
    }
  }

  function toggleVolume(e: Event) {
    const btn = e.target as HTMLButtonElement;
    const video = btn.closest('.reel-video-container')?.querySelector('video') as HTMLVideoElement;
    
    if (!video) return;

    if (video.muted) {
      video.muted = false;
      btn.textContent = '🔊';
    } else {
      video.muted = true;
      btn.textContent = '🔇';
    }
  }

  function seek(event: Event) {
    const e = event as MouseEvent;
    const progressBar = e.currentTarget as HTMLElement;
    const video = progressBar.closest('.reel-player-controls')?.closest('.reel-video-container')?.querySelector('video') as HTMLVideoElement;
    
    if (!video) return;

    const rect = progressBar.getBoundingClientRect();
    const percent = (e.clientX - rect.left) / rect.width;
    video.currentTime = percent * video.duration;
  }

  function toggleLike(btn: Element) {
    btn.classList.toggle('liked');
  }

  // Inicializar videos
  document.querySelectorAll('.reel-video').forEach((video: Element) => {
    const videoElement = video as HTMLVideoElement;
    
    // Click en cualquier parte del video para reproducir/pausar
    videoElement.addEventListener('click', function() {
      if (this.paused) {
        pauseAllVideos();
        currentPlayingVideo = this;
        
        // Obtener URL de Instagram
        const container = this.closest('.reel-video-container');
        const instagramLink = container?.querySelector('a') as HTMLAnchorElement;
        const instagramUrl = instagramLink?.href || 'https://instagram.com';
        
        openInstagramModal(instagramUrl);
        
        this.play().catch(err => console.log('Play error:', err));
        const playBtn = container?.querySelector('.play-btn');
        if (playBtn) playBtn.textContent = '⏸️';
      } else {
        this.pause();
        currentPlayingVideo = null;
        const playBtn = this.closest('.reel-video-container')?.querySelector('.play-btn');
        if (playBtn) playBtn.textContent = '▶️';
      }
    });

    // Actualizar barra de progreso
    videoElement.addEventListener('timeupdate', function() {
      const container = this.closest('.reel-video-container');
      if (!container) return;
      
      const fill = container.querySelector('.progress-bar-fill') as HTMLElement;
      const time = container.querySelector('.time-display') as HTMLElement;
      
      if (this.duration) {
        const percent = (this.currentTime / this.duration) * 100;
        if (fill) fill.style.width = percent + '%';
        
        const mins = Math.floor(this.currentTime / 60);
        const secs = Math.floor(this.currentTime % 60);
        if (time) time.textContent = `${mins}:${secs.toString().padStart(2, '0')}`;
      }
    });

    videoElement.addEventListener('ended', function() {
      const container = this.closest('.reel-video-container');
      const btn = container?.querySelector('.play-btn');
      if (btn) btn.textContent = '▶️';
    });

    // Cargar metadatos
    videoElement.addEventListener('loadedmetadata', function() {
      console.log('Video cargado:', this.duration);
    });
  });
</script>