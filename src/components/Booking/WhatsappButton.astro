---
// src/components/Booking/WhatsappButton.astro
// Widget flotante de WhatsApp (abajo a la derecha), color clínica.
import siteData from "@config/siteData.json";

const { whatsappNumber, whatsappMessage } = siteData.booking;
const href = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<a
	href={href}
	class="wa-fab"
	target="_blank"
	rel="noopener noreferrer"
	aria-label="Escríbenos por WhatsApp"
	title="Escríbenos por WhatsApp"
>
	<svg
		class="wa-icon"
		viewBox="0 0 32 32"
		fill="currentColor"
		aria-hidden="true"
		focusable="false"
	>
		<path
			d="M16.003 3.2c-7.06 0-12.8 5.74-12.8 12.8 0 2.256.59 4.46 1.71 6.402L3.2 28.8l6.57-1.723a12.74 12.74 0 006.233 1.588h.005c7.06 0 12.8-5.74 12.8-12.8 0-3.42-1.332-6.635-3.752-9.055A12.72 12.72 0 0016.003 3.2zm0 23.36h-.004a10.57 10.57 0 01-5.386-1.475l-.386-.23-3.9 1.023 1.04-3.803-.252-.39a10.55 10.55 0 01-1.617-5.634c0-5.86 4.77-10.63 10.635-10.63a10.56 10.56 0 017.517 3.116 10.56 10.56 0 013.114 7.52c0 5.862-4.77 10.632-10.634 10.632zm5.83-7.96c-.32-.16-1.89-.933-2.183-1.04-.293-.107-.506-.16-.72.16-.213.32-.826 1.04-1.013 1.253-.187.213-.373.24-.693.08-.32-.16-1.35-.498-2.57-1.586-.95-.848-1.592-1.895-1.778-2.215-.187-.32-.02-.493.14-.652.144-.143.32-.373.48-.56.16-.187.213-.32.32-.533.107-.213.053-.4-.027-.56-.08-.16-.72-1.734-.986-2.374-.26-.624-.524-.54-.72-.55l-.613-.01c-.213 0-.56.08-.853.4-.293.32-1.12 1.094-1.12 2.667 0 1.574 1.147 3.094 1.307 3.307.16.213 2.253 3.44 5.46 4.823.763.33 1.36.527 1.825.674.767.244 1.464.21 2.016.128.615-.092 1.89-.773 2.156-1.52.267-.747.267-1.387.187-1.52-.08-.133-.293-.213-.613-.373z"
		></path>
	</svg>
	<span class="wa-pulse" aria-hidden="true"></span>
</a>

<style>
	.wa-fab {
		position: fixed;
		right: clamp(16px, 4vw, 28px);
		bottom: clamp(16px, 4vw, 28px);
		z-index: 60;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 56px;
		height: 56px;
		border-radius: 50%;
		background: #4f7a7c; /* color de la clínica */
		color: #ffffff;
		box-shadow: 0 6px 20px rgba(47, 62, 70, 0.28);
		transition:
			transform 0.25s ease,
			background 0.25s ease,
			box-shadow 0.25s ease;
	}

	.wa-fab:hover,
	.wa-fab:focus-visible {
		background: #3f6668;
		transform: translateY(-3px) scale(1.05);
		box-shadow: 0 10px 26px rgba(47, 62, 70, 0.38);
		outline: none;
	}

	.wa-icon {
		width: 30px;
		height: 30px;
		position: relative;
		z-index: 1;
	}

	/* Anillo de pulso sutil para llamar la atención sin ser invasivo */
	.wa-pulse {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: #4f7a7c;
		z-index: 0;
		animation: wa-pulse 2.6s ease-out infinite;
	}

	@keyframes wa-pulse {
		0% {
			transform: scale(1);
			opacity: 0.55;
		}
		70% {
			transform: scale(1.7);
			opacity: 0;
		}
		100% {
			transform: scale(1.7);
			opacity: 0;
		}
	}

	/* Respeta a quienes prefieren menos movimiento */
	@media (prefers-reduced-motion: reduce) {
		.wa-pulse {
			animation: none;
			display: none;
		}
		.wa-fab {
			transition: background 0.25s ease;
		}
	}
</style>