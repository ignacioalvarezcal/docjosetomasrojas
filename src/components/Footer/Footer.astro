---
import SiteLogo from "@components/SiteLogo/SiteLogo.astro";
import siteData from "@config/siteData.json";
import { Icon } from "astro-icon/components";

import FooterLink from "./FooterLink.astro";

const today = new Date();
---

<footer class="bg-base-100/40 mt-12 flex flex-col items-center justify-center py-12">
    <div class="site-container w-full">
        {/* --- SECCIÓN DE ENLACES (SIN CAMBIOS) --- */}
        <div class="relative flex w-full flex-col items-center justify-center gap-y-4 text-lg md:flex-row md:items-end md:gap-x-16">
            <div class="flex justify-center gap-x-16">
                <FooterLink href="/#portfolio">Servicios</FooterLink>
                <FooterLink href="/#portfolio">Casos</FooterLink>
            </div>
            <div class="text-center order-first md:order-none md:-translate-y-8 mt-4">
                <SiteLogo class="font-bold text-[#34657F]" />
            </div>
            <div class="flex justify-center gap-x-16">
                <FooterLink href="/#pricing">Valores</FooterLink>
                <FooterLink href="/#contact">Contacto</FooterLink>
            </div>
        </div>

        {/* --- SECCIÓN "LETS CONNECT" (SIN CAMBIOS) --- */}
        <div class="description mx-auto mt-12 max-w-[21rem] px-4 text-center">
            <p class="mb-6">
                Sigueme en mis redes sociales
                y conoce mas sobre mí.
            </p>
            <span class="italic font-bold text-primary-1000">Contactame!</span>
        </div>

        {/* --- SECCIÓN DE REDES SOCIALES (ACTUALIZADA) --- */}
        {/* CAMBIO: Se aumentó el espaciado con "gap-8" */}
        <div class="mt-8 flex justify-center gap-8 items-center">
            {/* YouTube */}
            <a href="https://youtube.com/" target="_blank" rel="noopener noreferrer">
                <Icon
                    name="mdi:youtube"  
                    class="h-14 w-14 text-[#FF0000] transition hover:opacity-80"
                />
                <span class="sr-only">YouTube</span>
            </a>

            {/* CAMBIO: Ícono de LinkedIn agregado */}
            <a href="URL-DE-TU-PERFIL-DE-LINKEDIN" target="_blank" rel="noopener noreferrer">
                <Icon
                    name="mdi:linkedin" 
                    class="h-12 w-12 text-[#0077B5] transition hover:opacity-80"
                />
                <span class="sr-only">LinkedIn</span>
            </a>

            {/* Instagram */}
            <a href="https://instagram.com/docjosetomasrojas" target="_blank" rel="noopener noreferrer">
                <Icon
                    name="mdi:instagram"
                    class="h-12 w-12 text-[#C13584] transition hover:opacity-80"
                />
                <span class="sr-only">Instagram</span>
            </a>
        </div>

        <div class="mt-4 mb-2 text-center text-sm opacity-80">
            &copy; {today.getFullYear()} Desarrollado por <a
                href="https://isoft.cl"
                class="hover:text-primary-600 transition"
                target="_blank"
                rel="noopener">Isoft</a
            >
        </div>
    </div>
</footer>