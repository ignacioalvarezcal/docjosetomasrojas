---
import logo from "@images/logo/logojo.png";
import navData from "@config/navData.json";
import siteData from "@config/siteData.json";

const { dentalinkUrl, whatsappNumber, whatsappMessage } = siteData.booking;
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<div id="mobile-nav__container">
	<!-- Botón Hamburguesa Moderno -->
	<button
		id="mobile-nav__burger"
		aria-label="Abrir menú de navegación"
		aria-haspopup="true"
		aria-expanded="false"
		class="mobile-burger-btn"
	>
		<span class="burger-bar bar-1"></span>
		<span class="burger-bar bar-2"></span>
		<span class="burger-bar bar-3"></span>
	</button>

	<!-- Backdrop con Blur estilo iOS/Glassmorphism -->
	<div
		id="mobile-nav__backdrop"
		class="mobile-backdrop hidden"
		aria-hidden="true"
	></div>

	<!-- Sidebar Panel Drawer -->
	<div
		id="mobile-nav__content"
		class="mobile-drawer"
		aria-label="Menú principal móvil"
	>
		<div class="mobile-drawer-inner">
			<!-- Header del Menú -->
			<div class="mobile-drawer-header">
				<a href="/" class="mobile-brand" id="mobile-brand-link">
					<img src={logo.src} alt="Dr. José Tomás Rojas" class="mobile-brand-logo" />
					<div class="mobile-brand-text">
						<span class="mobile-brand-name">Dr. José Tomás Rojas</span>
						<span class="mobile-brand-spec">Implantología Oral</span>
					</div>
				</a>
				<button
					id="mobile-nav__close"
					class="mobile-close-btn"
					aria-label="Cerrar menú"
				>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mobile-close-icon">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				</button>
			</div>

			<!-- Separador sutil -->
			<div class="drawer-divider"></div>

			<!-- Lista de Navegación -->
			<nav class="mobile-nav-list-wrap">
				<ul class="mobile-nav-list">
					{
						navData.map((item, index) => (
							<li class="mobile-nav-item" style={`--item-index: ${index};`}>
								<a
									href={"link" in item ? item.link : "#"}
									class="mobile-nav-link"
								>
									<span class="mobile-nav-text">{"text" in item ? item.text : ""}</span>
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mobile-nav-arrow">
										<polyline points="9 18 15 12 9 6"></polyline>
									</svg>
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<!-- Footer con Acciones y Contacto -->
			<div class="mobile-drawer-footer">
				<a
					href={dentalinkUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="drawer-btn-cta"
				>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="drawer-btn-icon">
						<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
						<line x1="16" y1="2" x2="16" y2="6"></line>
						<line x1="8" y1="2" x2="8" y2="6"></line>
						<line x1="3" y1="10" x2="21" y2="10"></line>
					</svg>
					<span>Agendar hora online</span>
				</a>

				<a
					href={whatsappUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="drawer-btn-whatsapp"
				>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="drawer-btn-icon text-[#25D366]">
						<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
					</svg>
					<span>Consultar por WhatsApp</span>
				</a>

				<div class="mobile-drawer-clinic-info">
					<p class="clinic-location">Providencia, Santiago de Chile</p>
					<p class="clinic-hours">Atención personalizada con cita previa</p>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	function setupModernMobileNav() {
		const container = document.getElementById("mobile-nav__container");
		const burger = document.getElementById("mobile-nav__burger");
		const drawer = document.getElementById("mobile-nav__content");
		const closeBtn = document.getElementById("mobile-nav__close");
		const backdrop = document.getElementById("mobile-nav__backdrop");
		const navLinks = document.querySelectorAll(".mobile-nav-link, #mobile-brand-link");

		if (!burger || !drawer || !closeBtn || !backdrop || !container) return;

		function openMenu() {
			container.classList.add("is-open");
			burger.setAttribute("aria-expanded", "true");
			backdrop.classList.remove("hidden");
			document.body.style.overflow = "hidden"; // bloquea scroll de fondo
		}

		function closeMenu() {
			container.classList.remove("is-open");
			burger.setAttribute("aria-expanded", "false");
			document.body.style.overflow = ""; // restaura scroll

			// Espera a que termine la animación de slide-out antes de ocultar backdrop
			setTimeout(() => {
				if (!container.classList.contains("is-open")) {
					backdrop.classList.add("hidden");
				}
			}, 320);
		}

		burger.addEventListener("click", () => {
			if (container.classList.contains("is-open")) {
				closeMenu();
			} else {
				openMenu();
			}
		});

		closeBtn.addEventListener("click", closeMenu);
		backdrop.addEventListener("click", closeMenu);

		// Cierra el menú al hacer clic en cualquier ancla o link
		navLinks.forEach((link) => {
			link.addEventListener("click", () => {
				closeMenu();
			});
		});

		// Cierra con la tecla Escape
		window.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && container.classList.contains("is-open")) {
				closeMenu();
			}
		});
	}

	setupModernMobileNav();
	document.addEventListener("astro:after-swap", setupModernMobileNav);
</script>

<style>
	/* ===== BOTÓN HAMBURGUESA ===== */
	.mobile-burger-btn {
		width: 44px;
		height: 44px;
		border-radius: 10px;
		background: rgba(255, 255, 255, 0.7);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border: 1px solid rgba(79, 122, 124, 0.2);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 5px;
		cursor: pointer;
		padding: 0;
		transition: background 0.25s ease, border-color 0.25s ease, transform 0.2s ease;
	}

	.mobile-burger-btn:active {
		transform: scale(0.94);
		background: rgba(79, 122, 124, 0.1);
	}

	.burger-bar {
		width: 22px;
		height: 2px;
		background: #2f3e46;
		border-radius: 2px;
		transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
	}

	:global(#mobile-nav__container.is-open .bar-1) {
		transform: translateY(7px) rotate(45deg);
	}

	:global(#mobile-nav__container.is-open .bar-2) {
		opacity: 0;
		transform: scaleX(0);
	}

	:global(#mobile-nav__container.is-open .bar-3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	/* ===== BACKDROP BLUR ===== */
	.mobile-backdrop {
		position: fixed;
		inset: 0;
		z-index: 90;
		background: rgba(15, 31, 44, 0.45);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	:global(#mobile-nav__container.is-open .mobile-backdrop) {
		opacity: 1;
		pointer-events: auto;
	}

	/* ===== SIDEBAR DRAWER ===== */
	.mobile-drawer {
		position: fixed;
		top: 0;
		right: 0;
		bottom: 0;
		z-index: 100;
		width: 86vw;
		max-width: 350px;
		height: 100dvh;
		background: #ffffff;
		box-shadow: -14px 0 45px rgba(15, 31, 44, 0.22);
		border-left: 1px solid rgba(79, 122, 124, 0.12);
		transform: translateX(105%);
		transition: transform 0.38s cubic-bezier(0.16, 1, 0.3, 1);
		display: flex;
		flex-direction: column;
	}

	:global(#mobile-nav__container.is-open .mobile-drawer) {
		transform: translateX(0);
	}

	.mobile-drawer-inner {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 1.25rem 1.4rem 1.6rem;
		overflow-y: auto;
		-webkit-overflow-scrolling: touch;
	}

	/* ===== HEADER DEL DRAWER ===== */
	.mobile-drawer-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 0.85rem;
	}

	.mobile-brand {
		display: flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
	}

	.mobile-brand-logo {
		width: 36px;
		height: 36px;
		object-fit: contain;
	}

	.mobile-brand-text {
		display: flex;
		flex-direction: column;
	}

	.mobile-brand-name {
		font-family: "Playfair Display", serif;
		font-size: 0.98rem;
		font-weight: 600;
		color: #2f3e46;
		line-height: 1.15;
	}

	.mobile-brand-spec {
		font-family: "Montserrat", sans-serif;
		font-size: 0.7rem;
		font-weight: 500;
		color: #4f7a7c;
		letter-spacing: 0.04em;
	}

	.mobile-close-btn {
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: #f1f4f5;
		border: none;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		color: #4a4a4a;
		transition: background 0.2s ease, transform 0.2s ease, color 0.2s ease;
	}

	.mobile-close-btn:active {
		transform: scale(0.9);
		background: #e2e8e9;
		color: #2f3e46;
	}

	.mobile-close-icon {
		width: 20px;
		height: 20px;
	}

	.drawer-divider {
		height: 1px;
		background: linear-gradient(90deg, rgba(79, 122, 124, 0.2) 0%, rgba(79, 122, 124, 0.05) 100%);
		margin: 0.4rem 0 1rem;
	}

	/* ===== LISTA DE NAVEGACIÓN ===== */
	.mobile-nav-list-wrap {
		flex: 1;
		margin: 0.25rem 0 1.25rem;
	}

	.mobile-nav-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.mobile-nav-item {
		opacity: 0;
		transform: translateX(18px);
		transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
		transition-delay: calc(var(--item-index) * 45ms + 100ms);
	}

	:global(#mobile-nav__container.is-open .mobile-nav-item) {
		opacity: 1;
		transform: translateX(0);
	}

	.mobile-nav-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.85rem 1rem;
		border-radius: 10px;
		text-decoration: none;
		color: #2f3e46;
		font-family: "Montserrat", sans-serif;
		font-size: 0.96rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		transition: background 0.2s ease, color 0.2s ease, transform 0.15s ease;
	}

	.mobile-nav-link:active {
		background: rgba(79, 122, 124, 0.1);
		color: #4f7a7c;
		transform: translateX(4px);
	}

	.mobile-nav-arrow {
		width: 18px;
		height: 18px;
		color: #9fb6b8;
		transition: transform 0.2s ease, color 0.2s ease;
	}

	.mobile-nav-link:active .mobile-nav-arrow {
		transform: translateX(3px);
		color: #4f7a7c;
	}

	/* ===== FOOTER Y ACCIONES ===== */
	.mobile-drawer-footer {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding-top: 1rem;
		border-top: 1px solid rgba(79, 122, 124, 0.12);
	}

	.drawer-btn-cta {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		width: 100%;
		padding: 0.85rem 1.25rem;
		border-radius: 10px;
		background: linear-gradient(135deg, #4f7a7c 0%, #3f6668 100%);
		color: #ffffff;
		text-decoration: none;
		font-family: "Montserrat", sans-serif;
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 0.03em;
		box-shadow: 0 4px 14px rgba(79, 122, 124, 0.28);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.drawer-btn-cta:active {
		transform: scale(0.98);
		box-shadow: 0 2px 8px rgba(79, 122, 124, 0.35);
	}

	.drawer-btn-whatsapp {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		width: 100%;
		padding: 0.8rem 1.25rem;
		border-radius: 10px;
		background: #ffffff;
		border: 1px solid rgba(79, 122, 124, 0.25);
		color: #2f3e46;
		text-decoration: none;
		font-family: "Montserrat", sans-serif;
		font-size: 0.88rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
	}

	.drawer-btn-whatsapp:active {
		background: #f7f9f9;
		transform: scale(0.98);
	}

	.drawer-btn-icon {
		width: 19px;
		height: 19px;
		flex-shrink: 0;
	}

	.mobile-drawer-clinic-info {
		text-align: center;
		margin-top: 0.35rem;
	}

	.clinic-location {
		font-size: 0.72rem;
		color: #6b7b82;
		font-weight: 500;
	}

	.clinic-hours {
		font-size: 0.68rem;
		color: #9fb6b8;
		margin-top: 2px;
	}

	/* Blindaje contra reglas globales del navbar superior */
	:global(#nav__container.initial .burger-bar),
	:global(#nav__container.scrolled .burger-bar) {
		background: #2f3e46 !important;
	}

	:global(#nav__container.initial .mobile-drawer),
	:global(#nav__container.scrolled .mobile-drawer) {
		color: #2f3e46 !important;
	}

	:global(#nav__container.initial .mobile-brand-name) {
		color: #2f3e46 !important;
	}

	:global(#nav__container.initial .mobile-brand-spec) {
		color: #4f7a7c !important;
	}

	:global(#nav__container.initial .drawer-btn-cta),
	:global(#nav__container.initial .drawer-btn-cta *) {
		color: #ffffff !important;
	}

	:global(#nav__container.initial .drawer-btn-whatsapp) {
		color: #2f3e46 !important;
	}
</style>
