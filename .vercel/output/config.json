{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/about/?$",
			"dest": "_render"
		},
		{
			"src": "^/agendar/?$",
			"dest": "_render"
		},
		{
			"src": "^/casos-clinicos/?$",
			"dest": "_render"
		},
		{
			"src": "^/conoceme-mas/?$",
			"dest": "_render"
		},
		{
			"src": "^/contact-me/?$",
			"dest": "_render"
		},
		{
			"src": "^/portfolio/?$",
			"dest": "_render"
		},
		{
			"src": "^/portfolio(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/services/?$",
			"dest": "_render"
		},
		{
			"src": "^/servicios/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}